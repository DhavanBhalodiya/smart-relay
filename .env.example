# Optional. `npx @theone1345/smartrelay setup` prompts for these in the terminal
# and writes them to ~/.smartrelay/.env (mode 600), which works from any
# directory — use this file only if you want the keys scoped to this checkout.
#
# Precedence, highest first:
#   process.env  >  ./.env  >  <project root>/.env  >  ~/.smartrelay/.env
#
# (Never commit your actual .env file to git)

# LLM Provider Keys (for MCP/HTTP server)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
OPENROUTER_API_KEY=sk-or-v1-...
NVIDIA_API_KEY=nvapi-...

# HTTP API Authentication (for smartrelay-http server)
SMARTRELAY_HTTP_API_KEY=your-secure-bearer-token-here
