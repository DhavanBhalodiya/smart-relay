{
  "name": "@theone1345/smartrelay",
  "version": "0.3.0",
  "description": "MCP server for delegating tasks across LLM backends and benchmarking their outputs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dispatch": {
      "types": "./dist/tools/dispatch.d.ts",
      "default": "./dist/tools/dispatch.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Dhavan Bhalodiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DhavanBhalodiya/smart-relay.git"
  },
  "bugs": {
    "url": "https://github.com/DhavanBhalodiya/smart-relay/issues"
  },
  "homepage": "https://github.com/DhavanBhalodiya/smart-relay#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "windsurf",
    "subagents",
    "openrouter",
    "nvidia",
    "ollama"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "smartrelay": "dist/server.js",
    "mcp-delegation-server": "dist/server.js",
    "smartrelay-http": "dist/http-api.js",
    "smartrelay-setup": "dist/setup.js"
  },
  "files": [
    "dist",
    "config",
    "config.yaml",
    "prompts"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/http-api.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/http-api.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "quick-test": "tsx scripts/quick-test.ts",
    "test:plugin": "tsx scripts/test-plugin.ts",
    "test:review": "tsx scripts/test-review.ts",
    "setup": "tsx src/setup.ts",
    "build:plugin": "npm --workspace plugin-smartrelay run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fastify": "^5.12.3",
    "openai": "^7.12.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "plugin-smartrelay"
  ],
  "publishConfig": {
    "access": "public"
  }
}
